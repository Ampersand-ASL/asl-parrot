# ===========================================================
# Configure these settings before starting your node.
AMP_NODE0_NUMBER=999999
AMP_NODE0_PASSWORD=xxx
AMP_IAX_PROTO=IPV4
AMP_IAX_PORT=4569
# Network interface (IPv4) that is used to initiate network tests.
# Needs to be different from the interface accepting IAX connections
# for the test to be fully effective
AMP_NET_TEST_BIND_ADDR4=0.0.0.0
# Uncomment this to join the parrot into the conference so that everyone
# can hear the recording/playback.
#export AMP_PARROT_MODE=CONFERENCE
# This variable turns on the N2DYI "program mode" and points to the root 
# of the program directory.
#export AMP_PROGRAM_ROOT=/tmp/program
# ===========================================================

# These probably won't need to be changed:

# These parameter is used to set the parrot thresholds.
AMP_PARROT_LEVEL_MEASURE=DBFS_PEAK
# These are the lower bounds of "very high", "high", "good", and "low".
# Anything below the last number is "very low".
AMP_PARROT_LEVEL_THRESHOLDS=-2,-5,-9,-12

# Used to set the port that the API server listens on
AMP_HTTP_PORT=8080
# This is the URL that the registration is posted to periodically
AMP_ASL_REG_URL=https://register.allstarlink.org
# This is the URL that the stats are posted to periodically
AMP_ASL_STAT_URL=http://stats.allstarlink.org/uhandler.php
# All DNS records are based on this root
AMP_ASL_DNS_BASE=nodes.allstarlink.org
# Pointer to Piper TTS files (voice and the espeak runtime files)
AMP_PIPER_DIR=/etc
